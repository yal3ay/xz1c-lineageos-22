--- /dev/null
+++ b/apps/ZramStatus/src/main/java/org/lineageos/zramstatus/CrashSanitizer.java
@@ -0,0 +1,102 @@
+package org.lineageos.zramstatus;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Extracts a narrow technical schema. Raw messages, paths and log lines never leave this class. */
+final class CrashSanitizer {
+    static final int MAX_INPUT = 65536;
+    static final int MAX_FRAMES = 48;
+    static final Set<String> TAGS = Collections.unmodifiableSet(new LinkedHashSet<>(Arrays.asList(
+            "data_app_crash", "system_app_crash", "system_server_crash",
+            "data_app_native_crash", "system_app_native_crash", "system_server_native_crash",
+            "data_app_anr", "system_app_anr", "system_server_anr")));
+    private static final String NAME = "[A-Za-z_$][A-Za-z0-9_$]*";
+    private static final String QUALIFIED = NAME + "(?:\\." + NAME + ")+";
+    private static final Pattern PACKAGE = Pattern.compile("^Package: (" + QUALIFIED + ")(?: v[0-9]+(?: .*)?)?$");
+    private static final Pattern PROCESS = Pattern.compile("^Process: (" + QUALIFIED + ")(?:[:][A-Za-z0-9_.-]+)?$");
+    private static final Pattern UID = Pattern.compile("^UID: ([0-9]{1,8})$", Pattern.CASE_INSENSITIVE);
+    private static final Pattern EXCEPTION = Pattern.compile(
+            "^(?:(?:Caused by|Suppressed): )?((?:" + NAME + "\\.)*" + NAME
+                    + ")(?::.*)?$");
+    private static final Pattern FRAME = Pattern.compile(
+            "^at ((?:" + NAME + "\\.)+(?:" + NAME + "|<init>|<clinit>))"
+                    + "\\(((?:[A-Za-z0-9_$]+\\.(?:java|kt)(?::[0-9]{1,6})?)|Unknown Source|Native Method)\\)$");
+    private static final Pattern NATIVE = Pattern.compile(
+            "^#[0-9]{2}\\s+pc\\s+([0-9a-fA-F]{1,16})\\s+[^\\s]*[/]"
+                    + "(lib[A-Za-z0-9_.+-]{1,100}\\.so)(?:\\s.*)?$");
+    private static final Pattern SIGNAL = Pattern.compile("^signal (?:4|6|7|8|11|31) \\((SIGILL|SIGABRT|SIGBUS|SIGFPE|SIGSEGV|SIGSYS)\\).*$");
+
+    static final class Result {
+        String packageName;
+        int uid = -1; // Only used in memory for the current-user ownership check; never serialized.
+        final String kind;
+        String signal = "";
+        final List<String> exceptions = new ArrayList<>();
+        final List<String> frames = new ArrayList<>();
+        Result(String kind) { this.kind = kind; }
+    }
+
+    static Result parse(String tag, String input, int userId) {
+        if (!TAGS.contains(tag) || input == null || userId != 0) return null;
+        String text = input.substring(0, Math.min(input.length(), MAX_INPUT));
+        Result r = new Result(tag.endsWith("_anr") ? "anr"
+                : tag.endsWith("_native_crash") ? "native_crash" : "crash");
+        boolean systemServer = tag.startsWith("system_server_");
+        boolean systemServerHeader = false;
+        // Header fields are accepted only before the first blank line, not from exception messages.
+        boolean inHeader = true;
+        boolean packageFound = false;
+        for (String line : text.split("\\r?\\n", -1)) {
+            String s = line.trim();
+            if (s.isEmpty()) { inHeader = false; continue; }
+            // Bound regex recursion and parsing cost even for malformed crash text.
+            if (s.length() > 512) continue;
+            Matcher m;
+            if (inHeader) {
+                if (s.equals("Process: system_server")) systemServerHeader = true;
+                if ((m = UID.matcher(s)).matches()) {
+                    try { r.uid = Integer.parseInt(m.group(1)); } catch (NumberFormatException ignored) { }
+                }
+                if (!packageFound && (m = PACKAGE.matcher(s)).matches()) {
+                    r.packageName = m.group(1); packageFound = true;
+                }
+                if (r.packageName == null && (m = PROCESS.matcher(s)).matches()) r.packageName = m.group(1);
+            }
+            if ((m = EXCEPTION.matcher(s)).matches() && r.exceptions.size() < 6) {
+                String type = m.group(1);
+                if (type.length() <= 180 && (type.endsWith("Exception") || type.endsWith("Error")
+                        || type.endsWith("Throwable")) && !r.exceptions.contains(type)) r.exceptions.add(type);
+            } else if ((m = FRAME.matcher(s)).matches() && r.frames.size() < MAX_FRAMES) {
+                String frame = m.group(1) + "(" + m.group(2) + ")";
+                if (frame.length() <= 240) r.frames.add(frame);
+            } else if ((m = NATIVE.matcher(s)).matches() && r.frames.size() < MAX_FRAMES) {
+                r.frames.add(m.group(2) + "+0x" + m.group(1).toLowerCase(java.util.Locale.ROOT));
+            } else if ((m = SIGNAL.matcher(s)).matches()) {
+                r.signal = m.group(1);
+            }
+        }
+        if (systemServer) {
+            if (!systemServerHeader || (r.uid >= 0 && r.uid != 1000)) return null;
+            r.packageName = "android";
+            r.uid = 1000;
+        } else if (r.uid < 0 || r.uid / 100000 != userId || !isPackageName(r.packageName)) {
+            // Unknown ownership or another user's/work profile's record: do not collect it.
+            return null;
+        }
+        return r;
+    }
+
+    static boolean isPackageName(String value) {
+        return value != null && value.length() <= 180
+                && (value.equals("android") || value.matches(QUALIFIED));
+    }
+
+    private CrashSanitizer() { }
+}
diff --git a/apps/ZramStatus/src/main/java/org/lineageos/zramstatus/FeedbackActivity.java b/apps/ZramStatus/src/main/java/org/lineageos/zramstatus/FeedbackActivity.java
