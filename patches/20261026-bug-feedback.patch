         addAction(grid, R.drawable.ic_sm_battery, R.string.battery, 0xff22b3a6, blend(0xffffffff, 0xff22b3a6, 0.13f),
                 () -> openFeature(FeatureActivity.PAGE_BATTERY));
         // NAS (network storage) is switched off; the page and NasScanJob stay in the code.
