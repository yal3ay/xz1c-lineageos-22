    <!-- Explicitly opted-in, local-only technical problem reports. -->
    <string name="feedback_title">Bug reports</string>
    <string name="feedback_privacy_title">You decide what to share</string>
    <string name="feedback_privacy_body">Manual reports include your chosen app, version and description. Automatic crash reports include error types and code locations. A user-started reproduction session also records memory and screen state and up to 48 media diagnostic lines from the recording window; shared media-service records may relate to other players. Network addresses in diagnostic lines are replaced. Fields that cannot be read are marked unavailable. Up to 20 local reports are kept for 7 days; received reports for up to 30 days. Nothing is submitted until you review and confirm. Optional screen video requires system permission, may contain personal information, and is reviewed separately. No audio is recorded.</string>
    <string name="feedback_recipient">Yal3AY</string>
    <string name="feedback_recipient_line">Intended recipient: %1$s</string>
    <string name="feedback_owner_only">Available only to the phone owner. Work profiles and other users are excluded.</string>
    <string name="feedback_enable">Save crash reports and remind me</string>
    <string name="feedback_enable_summary">Silent notification at most once every 24 hours. No popup, sound or vibration. You may ignore it.</string>
    <string name="feedback_enable_consent">Allow local collection of the limited technical fields listed above? Nothing is sent automatically. You can turn this off and delete saved reports at any time.</string>
