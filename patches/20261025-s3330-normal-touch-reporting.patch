+		 * assume the earlier reset still guarantees normal reporting.
+		 */
 		/* F12_2D_CTRL27_00: Wakeup Gesture Enable */
 		rc = clearpad_put(SYNA(this, F12_2D, CTRL, 27), 0);
 		if (rc) {
@@ -2340,6 +2345,12 @@
 		if (rc) {
 			LOGE(this, "failed to disable report gesture\n");
 			goto end;
+		}
+
+		/* The existing S3500 calibration is not needed on S3330. */
+		if (this->chip_id == SYN_CHIP_3330) {
+			LOGI(this, "S3330 normal touch reporting restored\n");
+			break;
 		}
 
