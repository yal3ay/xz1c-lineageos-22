--- a/drivers/input/touchscreen/clearpad_core.c
+++ b/drivers/input/touchscreen/clearpad_core.c
@@ -2314,11 +2314,16 @@
 	}
 
 	switch (this->chip_id) {
-	case SYN_CHIP_3330:
 	case SYN_CHIP_332U:
 		LOGD(this, "already disabled wakeup gesture by HW reset\n");
 		break;
+	case SYN_CHIP_3330:
 	case SYN_CHIP_3500:
+		/*
+		 * S3330 may be put back into gesture mode after its reset
